generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  professor
  student
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password            String?
  role                Role      @default(student)
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  starRecords   StarRecord[] @relation("StudentRecords")
  recordedStars StarRecord[] @relation("RecorderRecords")
  classes       Class[]
  passwordResets PasswordReset[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id          String   @id @default(cuid())
  title       String?
  date        DateTime @default(now())
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User         @relation(fields: [createdById], references: [id])
  starRecords StarRecord[]
}

model StarRecord {
  id           String   @id @default(cuid())
  classId      String
  studentId    String
  stars        Int
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User  @relation("StudentRecords", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("RecorderRecords", fields: [recordedById], references: [id])

  @@unique([classId, studentId])
}
